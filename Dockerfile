FROM node:22-alpine
WORKDIR /app
COPY package.json CHANGELOG.md ./
COPY src ./src
ARG GIT_SHA=unknown
ARG RELEASE_TAG=unreleased
ARG COMMIT_SUBJECT=""
ARG BUILD_TIME=""
ARG RUN_URL=""
ENV GIT_SHA=$GIT_SHA RELEASE_TAG=$RELEASE_TAG COMMIT_SUBJECT=$COMMIT_SUBJECT BUILD_TIME=$BUILD_TIME RUN_URL=$RUN_URL
USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
